# ==============================================================================
# ChefTech Ordering Website — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Or configure your Supabase Project URL and Anon Public Key via:
#    - config.js (DEFAULT_SUPABASE_URL & DEFAULT_SUPABASE_ANON_KEY), OR
#    - Admin Dashboard -> Cloud Setup modal
# 3. Only your public anon key should ever be placed in browser files.
# ==============================================================================

# Web Server Port (default: 3000)
PORT=3000

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Allowed CORS Origins for Supabase Edge Functions (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com
